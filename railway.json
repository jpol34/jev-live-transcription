{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install uv && uv pip install --system --no-cache -e ."
  },
  "deploy": {
    "startCommand": "uvicorn jev_live_transcription.webapp.app:app --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "ON_FAILURE"
  }
}
